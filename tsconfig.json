{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],

    "rootDir": "src",
    "outDir": "out",

    "strict": true,
    "noEmitOnError": true,

    "sourceMap": true,
    "declaration": true,

    "module": "CommonJS",

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
